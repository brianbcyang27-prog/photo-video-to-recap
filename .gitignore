# Virtualenv - recreate with ./setup.sh
.venv/

# User media and outputs. The media folder is where the real trip photos go;
# it is intentionally kept out of version control.
media/
out/
.work/
.cache/

# Run logs. These are per-run transcripts, not source: three of them had ended
# up tracked, so every render rewrote a file in the diff.
*.log

# Supplied music tracks and synthesised scores. Both are inputs or products of
# a render rather than source: a track is the user's own licensed copy, and a
# generated score is ~11MB of audio reproducible from --mood and --bpm.
music/
music_generated.wav

# Synthetic test libraries: ~800MB of generated files. Regenerate with
#   .venv/bin/python tools/make_test_media.py
#   .venv/bin/python tools/make_audio_library.py
test_media/
test_media_audio/
test_media_rot/

# macOS
.DS_Store

__pycache__/
*.pyc
downloads/
